{
  "name": "napoli-quartiere-zero",
  "version": "0.5.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx scripts/test-all.mjs",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:prepare": "node --import tsx scripts/prepare-city.ts",
    "city:plan": "node --import tsx scripts/acquire-city-sector.ts",
    "city:acquire": "node --import tsx scripts/acquire-city-sector.ts --execute",
    "city:pack": "node --import tsx scripts/prepare-city-sectors.ts",
    "city:municipal-plan": "node --import tsx scripts/prepare-municipal-sectors.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.1",
    "@babylonjs/loaders": "9.33.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "earcut": "3.0.2",
    "osmtogeojson": "3.0.0-beta.5",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/earcut": "3.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  }
}
