# Public browser key: use a separate Google Cloud key restricted to website referrers.
# Do not use a server credential. Never paste credentials into chat or commit a working key.
# Configure only after reviewing public/PHOTOREAL-SETUP.txt and approving API usage.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: district lookup is separately billed under Geocoding API.
VITE_GOOGLE_MAPS_GEOCODING_ENABLED=false
